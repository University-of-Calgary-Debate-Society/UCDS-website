# UCDS-2026 Python Backend Configuration Template
# Copy this file to '.env' and fill in your actual credentials.

# Gmail SMTP Configuration for Campaign Dispatch
UCDS_SENDER_EMAIL=ucds.debate@gmail.com
UCDS_SMTP_PASSWORD=your_gmail_16_character_app_password_here

# Path to the Firebase Admin Service Account Key JSON file
# E.g. backend/firebase-service-account.json or absolute path
FIREBASE_SERVICE_ACCOUNT_KEY=firebase-service-account.json

# Discord Bot Integration (for cross-posting to Discord server)
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ID=your_target_channel_id_here

# Meta (Facebook/Instagram Graph API) publishing credentials
FACEBOOK_PAGE_ACCESS_TOKEN=your_facebook_page_token_here
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_id_here

# X.com (Twitter) API credentials
X_API_KEY=your_x_api_key_here
X_API_SECRET=your_x_api_secret_here
X_ACCESS_TOKEN=your_x_access_token_here
X_ACCESS_SECRET=your_x_access_secret_here
